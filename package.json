{
  "name": "prism-blocks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src tests e2e scripts *.ts *.json *.html README.md",
    "icons": "node scripts/generate-icons.mjs",
    "build:html": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "test:html": "npm run build:html && playwright test --config playwright.portable.config.ts",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
